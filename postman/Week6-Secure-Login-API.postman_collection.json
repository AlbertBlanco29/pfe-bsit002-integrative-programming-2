{
    "info": {
        "_postman_id": "737e7f38-d977-4ddf-8fee-b8f753f59230",
        "name": "Week 6 - Secure Login API",
        "description": "Laboratory Activity 6: Register, login, token generation, protected routes (auth:sanctum), unauthorized rejection, and logout.\n\nRun in order: Register (or Login) \u2192 Employees - No Token \u2192 Employees - With Token \u2192 Logout \u2192 Employees - With Token again.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Register",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "// Save the token so the other requests can use it as {{token}}",
                            "const data = pm.response.json();",
                            "if (data.token) { pm.collectionVariables.set('token', data.token); }"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"name\": \"Admin User\",\n    \"email\": \"admin@example.com\",\n    \"password\": \"password123\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{base_url}}/api/register",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "register"
                    ]
                },
                "description": "Creates a new user. Expected: 201 Created with a token."
            }
        },
        {
            "name": "Login",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "// Save the token so the other requests can use it as {{token}}",
                            "const data = pm.response.json();",
                            "if (data.token) { pm.collectionVariables.set('token', data.token); }"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"email\": \"admin@example.com\",\n    \"password\": \"password123\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{base_url}}/api/login",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "login"
                    ]
                },
                "description": "Logs in and returns a new token. Expected: 200 OK. Wrong password: 401."
            }
        },
        {
            "name": "Employees - No Token",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/api/v1/employees",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "employees"
                    ]
                },
                "description": "Protected route without a token. Expected: 401 Unauthenticated."
            }
        },
        {
            "name": "Employees - With Token",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json",
                        "type": "text"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/api/v1/employees",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "employees"
                    ]
                },
                "description": "Protected route with Bearer token. Expected: 200 OK with paginated employees."
            }
        },
        {
            "name": "Logout",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json",
                        "type": "text"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/api/logout",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "logout"
                    ]
                },
                "description": "Deletes the current token. Expected: 200 OK. Sending Employees - With Token again afterwards returns 401."
            }
        }
    ],
    "variable": [
        {
            "key": "base_url",
            "value": "http://127.0.0.1:8000",
            "type": "string"
        },
        {
            "key": "token",
            "value": "",
            "type": "string"
        }
    ]
}